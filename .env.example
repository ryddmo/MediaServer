# Copy this to .env on the NAS (/volume2/docker/compose/.env) and fill in real values.
# Never commit the real .env — it holds PIA credentials.

PUID=1000
PGID=10
TZ=Europe/Stockholm

# Private Internet Access (used by gluetun)
OPENVPN_USER=
OPENVPN_PASSWORD=
# Gluetun region name for PIA, e.g. Germany, Netherlands, Sweden — see
# https://github.com/qdm12/gluetun-wiki/blob/main/setup/servers.md for the full list.
PIA_SERVER_REGION=Germany
